{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "declaration": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "types": ["react", "vitest/globals", "node"],
    "outDir": "dist", "rootDir": "."
  },
  "include": ["src", "test", "src/types"]
}
